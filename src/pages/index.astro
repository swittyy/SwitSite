---
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Project } from "@types/site";

const base = import.meta.env.BASE_URL;

const projects: Project[] = [
  {
    name: "SweeBox",
    description: "Модульный VPN-клиент с TUI-интерфейсом на Rust и Xray-core.",
    status: "in-progress",
    href: "https://github.com/swittyy/SweeBox",
    tags: ["Rust", "Linux", "Xray-core"],
  },
  {
    name: "SwitSite",
    description: "Моё личное пространство в интернете. Этот сайт — тоже проект.",
    status: "in-progress",
    href: "https://github.com/swittyy/SwitSite",
    tags: ["Astro", "TypeScript", "CSS"],
  },
];

const statusLabels: Record<Project["status"], string> = {
  "in-progress": "В разработке",
  planned: "В планах",
  completed: "Завершён",
};
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow">Personal space · Internet</span>
      <h1>Switty<span>.</span></h1>
      <div class="rust-tagline hero-rust-tagline is-transfer-hidden" id="hero-rust-tagline"><img class="rust-symbol" src={`${base}/rust-logo.svg`} alt="" aria-hidden="true" /><span>Rust. Learn. Evolve.</span></div>
      <p class="hero-description">
        Люблю Linux, пишу код, исследую технологии и собираю здесь то,
        что отражает мой маленький уголок интернета.
      </p>
      <div class="hero-actions">
        <a class="primary-button" href={`${base}projects/`}>Мои проекты <span aria-hidden="true">↗</span></a>
        <a class="secondary-button" href={`${base}contacts/`}>Связаться</a>
      </div>
      <div class="hero-meta">
        <span class="status-dot"></span>
        <span>Сейчас что-то создаю</span>
        <span class="meta-separator">/</span>
        <span class="mono">swittyy</span>
      </div>
    </div>

    <div class="hero-art" aria-label="Абстрактная декоративная композиция">
      <div class="orbit orbit-one"></div>
      <div class="orbit orbit-two"></div>
      <div class="orbit orbit-three"></div>
      <div class="art-core"><span>s.</span></div>
      <span class="art-label label-top">CURIOUS BY DEFAULT</span>
      <span class="art-label label-bottom">BUILD · BREAK · LEARN</span>
      <span class="art-star star-one">✳</span>
      <span class="art-star star-two">✳</span>
    </div>
  </section>

  <section class="section container" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Selected work</span>
        <h2 id="projects-title">То, что я создаю</h2>
      </div>
      <a class="text-link" href={`${base}projects/`}>Все проекты <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-grid">
      {projects.map((project, index) => (
        <a class="project-card surface" href={project.href} target="_blank" rel="noreferrer">
          <div class="card-topline">
            <span class="project-index">0{index + 1} / PROJECT</span>
            <span class:list={["project-status", project.status]}>{statusLabels[project.status]}</span>
          </div>
          <div class="project-symbol" aria-hidden="true">{index === 0 ? "⌘" : "↗"}</div>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <div class="tag-list">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container more-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Explore</span>
        <h2>Ещё немного обо мне</h2>
      </div>
      <p>Не только код. Здесь постепенно появятся музыка, активность и способы связаться.</p>
    </div>

    <div class="explore-grid">
      <a class="explore-card surface" href={`${base}music/`}>
        <span class="explore-icon music-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M9 18V5l12-2v13M9 18c0 1.1-1.3 2-3 2s-3-.9-3-2 1.3-2 3-2 3 .9 3 2Zm12-2c0 1.1-1.3 2-3 2s-3-.9-3-2 1.3-2 3-2 3 .9 3 2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="explore-title">Музыка</span>
        <span class="explore-description">Альбомы, которые хочется переслушивать.</span>
        <span class="explore-arrow">↗</span>
      </a>
      <a class="explore-card surface" href={`${base}github/`}>
        <span class="explore-icon"><svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.05c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.2 3.29 1.56.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.61 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.25-5.1 5.53.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.52A11.1 11.1 0 0 0 12 .9Z"/></svg></span>
        <span class="explore-title">GitHub</span>
        <span class="explore-description">Мои репозитории и открытая разработка.</span>
        <span class="explore-arrow">↗</span>
      </a>
      <a class="explore-card surface" href={`${base}contacts/`}>
        <span class="explore-icon people-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M16 21v-1.7a3.3 3.3 0 0 0-3.3-3.3H6.3A3.3 3.3 0 0 0 3 19.3V21m16 0v-1.7a3.3 3.3 0 0 0-2.5-3.2M9.5 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-7.7a4 4 0 0 1 0 7.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="explore-title">Контакты</span>
        <span class="explore-description">Места, где меня можно найти.</span>
        <span class="explore-arrow">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: 620px;
    align-items: center;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    padding-block: 5rem 4rem;
  }

  .hero h1 {
    margin: 1.25rem 0 1rem;
    font-size: clamp(3.4rem, 8vw, 6.8rem);
    font-weight: 800;
    letter-spacing: -0.09em;
    line-height: 0.98;
  }

  .hero h1 span {
    color: var(--accent);
  }

  .hero-rust-tagline { margin-top: 1.1rem; font-size: clamp(1.15rem, 2.4vw, 1.65rem); }

  .hero-description {
    max-width: 510px;
    margin: 1.6rem 0 2rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.8rem 1.25rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    transition: transform 180ms ease, background 180ms ease;
  }

  .primary-button {
    background: var(--accent);
    color: #241b35;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-3px);
  }

  .primary-button:hover {
    background: #e3d7ff;
  }

  .secondary-button {
    border: 1px solid var(--outline);
    background: rgb(255 255 255 / 3%);
  }

  .secondary-button:hover {
    background: var(--surface-high);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.8rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #9bd6a7;
    box-shadow: 0 0 12px rgb(155 214 167 / 65%);
  }

  .meta-separator {
    color: var(--outline);
  }

  .mono,
  .project-index {
    font-family: "DM Mono", monospace;
  }

  .hero-art {
    position: relative;
    display: grid;
    width: min(100%, 440px);
    aspect-ratio: 1;
    place-items: center;
    justify-self: end;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgb(255 143 54 / 16%);
    border-radius: 50%;
    animation: orbit 28s linear infinite;
  }

  .orbit-one {
    width: 94%;
    height: 94%;
  }

  .orbit-two {
    width: 72%;
    height: 72%;
    border-style: dashed;
    animation-direction: reverse;
    animation-duration: 36s;
  }

  .orbit-three {
    width: 52%;
    height: 52%;
    border-color: rgb(208 188 255 / 28%);
  }

  .art-core {
    display: grid;
    width: 37%;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 32%);
    border-radius: 34%;
    background: linear-gradient(145deg, #ffb15c, #e85b18);
    box-shadow: 0 25px 90px rgb(255 111 24 / 28%), inset 0 1px 1px rgb(255 255 255 / 80%);
    color: #241b35;
    transform: rotate(-12deg);
    animation: float 6s ease-in-out infinite;
  }

  .art-core span {
    font: 800 clamp(2.5rem, 6vw, 4.6rem) "DM Mono", monospace;
    letter-spacing: -0.12em;
    transform: rotate(12deg);
  }

  .art-label {
    position: absolute;
    color: var(--muted);
    font: 0.62rem "DM Mono", monospace;
    letter-spacing: 0.14em;
  }

  .label-top {
    top: 8%;
    right: 0;
  }

  .label-bottom {
    bottom: 8%;
    left: 0;
  }

  .art-star {
    position: absolute;
    color: var(--accent);
  }

  .star-one {
    top: 19%;
    left: 12%;
    font-size: 1.5rem;
  }

  .star-two {
    right: 12%;
    bottom: 19%;
    font-size: 1rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card {
    position: relative;
    display: flex;
    min-height: 290px;
    flex-direction: column;
    padding: 1.5rem;
    overflow: hidden;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .project-card:hover,
  .explore-card:hover {
    transform: translateY(-5px);
    border-color: rgb(255 143 54 / 35%);
    background-color: var(--surface-raised);
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-index {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .project-status {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: rgb(208 188 255 / 10%);
    color: var(--accent);
    font-size: 0.68rem;
  }

  .project-status.completed {
    background: rgb(155 214 167 / 10%);
    color: #9bd6a7;
  }

  .project-symbol {
    margin-top: 1.7rem;
    color: var(--accent);
    font: 2rem "DM Mono", monospace;
  }

  .project-card h3 {
    margin: 0.7rem 0 0.45rem;
    font-size: 1.6rem;
    letter-spacing: -0.06em;
  }

  .project-card p {
    max-width: 430px;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .tag-list span {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--outline);
    border-radius: 999px;
    color: #c9c2d2;
    font: 0.68rem "DM Mono", monospace;
  }

  .card-arrow {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    color: var(--accent);
    font-size: 1.1rem;
    opacity: 0;
    transform: translate(-5px, 5px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .project-card:hover .card-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .explore-card {
    position: relative;
    display: flex;
    min-height: 210px;
    flex-direction: column;
    padding: 1.4rem;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .explore-icon {
    display: inline-flex;
    color: var(--accent);
  }

  .explore-icon .github-icon { width: 1.7rem; height: 1.7rem; }
  .explore-icon svg { display: block; width: 2rem; height: 2rem; }
  .explore-icon.music-icon svg { width: 2.25rem; height: 2.25rem; }
  .explore-icon.people-icon svg { width: 2.15rem; height: 2.15rem; }

  .explore-title {
    margin-top: 1.5rem;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .explore-description {
    max-width: 230px;
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .explore-arrow {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    color: var(--muted);
  }

  @keyframes orbit {
    to { transform: rotate(360deg); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-12deg); }
    50% { transform: translateY(-12px) rotate(-8deg); }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-block: 5rem 2rem;
    }

    .hero-art {
      width: min(82%, 340px);
      justify-self: center;
      margin-top: 1rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .explore-grid {
      grid-template-columns: 1fr;
    }

    .explore-card {
      min-height: 170px;
    }
  }
</style>
