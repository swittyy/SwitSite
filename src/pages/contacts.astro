---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Контакты — Switty">
  <section class="page container">
    <span class="eyebrow">Say hello</span>
    <h1>Контакты<span>.</span></h1>
    <p>Если хочешь что-то обсудить, предложить идею или просто поболтать — вот где меня найти.</p>
    <div class="contact-grid">
      <a class="contact surface" href="https://t.me/switty_xd" target="_blank" rel="noreferrer"><span>Telegram</span><strong>@switty_xd</strong><span class="arrow">↗</span></a>
      <a class="contact surface" href="https://t.me/byswitty" target="_blank" rel="noreferrer"><span>Telegram channel</span><strong>@byswitty</strong><span class="arrow">↗</span></a>
      <a class="contact surface" href="https://github.com/swittyy" target="_blank" rel="noreferrer"><span>GitHub</span><strong>@swittyy</strong><span class="arrow">↗</span></a>
      <div class="contact surface"><span>Discord</span><strong>@switty_xd</strong><small>Добавлю ссылку-приглашение позже</small></div>
    </div>
  </section>
</BaseLayout>
<style>
  .page { min-height: 70vh; padding-block: 6rem; }
  h1 { margin: 1rem 0; font-size: clamp(3rem, 8vw, 5.5rem); letter-spacing: -.08em; }
  h1 span { color: var(--accent); }
  .page > p { max-width: 560px; color: var(--muted); line-height: 1.8; }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 3rem; }
  .contact { position: relative; display: grid; gap: .5rem; padding: 1.5rem; transition: border-color 180ms ease, transform 180ms ease; }
  a.contact:hover { transform: translateY(-3px); border-color: var(--accent); }
  .contact > span:first-child, .contact small { color: var(--muted); font-size: .8rem; }
  .contact strong { font-size: 1.2rem; }
  .arrow { position: absolute; top: 1.4rem; right: 1.5rem; color: var(--accent); }
  @media (max-width: 600px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
