---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Контакты — Switty">
  <section class="page container">
    <span class="eyebrow">Say hello</span>
    <h1>Контакты<span>.</span></h1>
    <p>Если хочешь что-то обсудить, предложить идею или просто поболтать — вот где меня найти.</p>
    <div class="contact-grid">
      <a class="contact surface" href="https://t.me/switty_xd" target="_blank" rel="noreferrer"><span>Telegram</span><strong>@switty_xd</strong><span class="contact-brand" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.8 4.2 18.6 19c-.24 1.05-.86 1.31-1.74.82l-4.82-3.55-2.32 2.23c-.26.26-.48.48-.98.48l.35-4.9 8.92-8.06c.39-.35-.09-.55-.61-.2L6.38 12.8l-4.7-1.47c-1.02-.32-1.04-1.02.21-1.51L20.3 2.6c.86-.32 1.62.21 1.5 1.6Z"/></svg></span></a>
      <a class="contact surface" href="https://t.me/byswitty" target="_blank" rel="noreferrer"><span>Telegram channel</span><strong>@byswitty</strong><span class="contact-brand" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.8 4.2 18.6 19c-.24 1.05-.86 1.31-1.74.82l-4.82-3.55-2.32 2.23c-.26.26-.48.48-.98.48l.35-4.9 8.92-8.06c.39-.35-.09-.55-.61-.2L6.38 12.8l-4.7-1.47c-1.02-.32-1.04-1.02.21-1.51L20.3 2.6c.86-.32 1.62.21 1.5 1.6Z"/></svg></span></a>
      <a class="contact surface" href="https://github.com/swittyy" target="_blank" rel="noreferrer"><span>GitHub</span><strong>@swittyy</strong><span class="contact-brand" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.21 3.26.92.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.11-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.62 5.24-5.11 5.51.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg></span></a>
      <a class="contact surface" href="https://discord.com/users/1569635234910314627" target="_blank" rel="noreferrer"><span>Discord</span><strong>@switty_xd</strong><span class="contact-brand" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19.7 5.1a18.2 18.2 0 0 0-4.5-1.4l-.56 1.14a16.8 16.8 0 0 0-5.28 0L8.8 3.7a18.2 18.2 0 0 0-4.5 1.4C1.45 9.3.68 13.4 1.06 17.45a18.3 18.3 0 0 0 5.52 2.8l1.19-1.94a11.9 11.9 0 0 1-1.87-.9l.46-.36a13 13 0 0 0 11.28 0l.46.36c-.6.36-1.23.66-1.88.9l1.2 1.94a18.3 18.3 0 0 0 5.52-2.8c.45-4.7-.77-8.76-3.24-12.35ZM8.73 14.8c-1.08 0-1.97-.98-1.97-2.18s.87-2.18 1.97-2.18 1.98.98 1.97 2.18c0 1.2-.87 2.18-1.97 2.18Zm6.54 0c-1.08 0-1.97-.98-1.97-2.18s.87-2.18 1.97-2.18 1.98.98 1.97 2.18c0 1.2-.87 2.18-1.97 2.18Z"/></svg></span></a>
    </div>
  </section>
</BaseLayout>
<style>
  .page { min-height: 70vh; padding-block: 6rem; }
  h1 { margin: 1rem 0; font-size: clamp(3rem, 8vw, 5.5rem); letter-spacing: -.08em; }
  h1 span { color: var(--accent); }
  .page > p { max-width: 560px; color: var(--muted); line-height: 1.8; }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 3rem; }
  .contact { position: relative; display: grid; gap: .5rem; padding: 1.5rem; transition: border-color 180ms ease, transform 180ms ease; }
  a.contact:hover { transform: translateY(-3px); border-color: var(--accent); }
  .contact > span:first-child, .contact small { color: var(--muted); font-size: .8rem; }
  .contact strong { font-size: 1.2rem; }
  .contact-brand { position: absolute; top: 1.3rem; right: 1.4rem; display: grid; place-items: center; width: 1.65rem; height: 1.65rem; color: var(--accent); }\n  .contact-brand svg { display: block; width: 100%; height: 100%; fill: currentColor; }
  @media (max-width: 600px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
