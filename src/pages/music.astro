---
import BaseLayout from "@layouts/BaseLayout.astro";

const tracks = [
  ["эпиграф", "2:26"],
  ["ащ-ащ!", "3:13"],
  ["странные запросы", "2:38"],
  ["ремарка", "3:02"],
  ["молодой авангардист", "2:42"],
  ["кажется, я устал", "2:50"],
  ["оставь меня", "5:00"],
  ["когда-нибудь", "2:53"],
  ["твой свет", "2:07"],
  ["оконченное письмо", "0:29"],
  ["чёрный кот", "4:35"],
  ["неплохая получилась история", "0:45"],
  ["пытаться понять", "3:21"],
  ["неважно", "4:39"],
  ["не знаю почему", "3:47"],
  ["интерлюдия №2", "0:31"],
  ["вечер мой", "2:25"],
  ["постскриптум", "1:44"],
  ["рябина", "5:20"],
];
---
<BaseLayout title="Музыка — Switty" description="Альбомы, которые я слушаю. Личная музыкальная библиотека Switty.">
  <section class="page container">
    <div class="page-heading">
      <span class="eyebrow">A little collection</span>
      <h1>Музыка<span>.</span></h1>
      <p>Альбомы, к которым хочется возвращаться. Никаких рекомендаций — просто то, что играет у меня.</p>
    </div>

    <section class="library" aria-label="Музыкальная библиотека">
      <article class="album surface">
        <div class="album-art" role="img" aria-label="Временная художественная заглушка для обложки альбома">
          <div class="art-grain"></div>
          <span class="art-index">№ 001 / 2024</span>
          <div class="art-center">
            <span class="art-small">КОНЕЦ СОЛНЕЧНЫХ ДНЕЙ</span>
            <span class="art-title">несколько<br />вопросов<br />самому себе</span>
          </div>
          <span class="art-bottom">A LITTLE RECORD OF FEELINGS</span>
        </div>

        <div class="album-info">
          <div class="album-kicker">В библиотеке <span>01</span></div>
          <h2>несколько вопросов<br class="desktop-break" /> самому себе</h2>
          <p class="artist">конец солнечных дней</p>
          <p class="album-description">Альбом о внутренних переживаниях, усталости и попытках разобраться в себе. Тот самый, который крутится во FLAC в cmus.</p>

          <div class="album-meta">
            <span>2024</span><i></i><span>19 треков</span><i></i><span>54:27</span>
          </div>

          <div class="album-actions">
            <a class="listen-button" href="https://open.spotify.com/album/5fnJSCxz6Kqa40pKp7D4fe" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.59 14.42a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.1-10.55-1.15a.75.75 0 1 1-.33-1.46c4.58-1.04 8.51-.59 11.66 1.33.35.21.46.67.25 1.03Zm1.35-3.01a.94.94 0 0 1-1.29.31c-3.23-1.99-8.15-2.57-11.97-1.4a.94.94 0 1 1-.55-1.8c4.36-1.32 9.78-.68 13.5 1.6.44.27.58.84.31 1.29Zm.12-3.14c-3.87-2.3-10.27-2.52-13.98-1.39a1.13 1.13 0 1 1-.66-2.16c4.26-1.29 11.34-1.04 15.81 1.61a1.13 1.13 0 0 1-1.17 1.94Z"/></svg>
              Слушать альбом
            </a>
            <a class="text-link" href="https://www.qobuz.com/us-en/album/-/tl9n8yz3sxhka" target="_blank" rel="noreferrer">Qobuz ↗</a>
          </div>
        </div>
      </article>

      <section class="favorite-track surface" aria-label="Любимая композиция">
        <div class="favorite-label"><span class="favorite-dot"></span> МОЯ ЛЮБИМАЯ КОМПОЗИЦИЯ</div>
        <div class="favorite-main">
          <div class="favorite-play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.8c0-.78.85-1.26 1.52-.86l9.1 5.45a1 1 0 0 1 0 1.72l-9.1 5.45A1 1 0 0 1 8 16.7V5.8Z"/></svg>
          </div>
          <div class="favorite-copy">
            <span class="favorite-overline">КОНЕЦ СОЛНЕЧНЫХ ДНЕЙ</span>
            <h3>неважно</h3>
            <span class="favorite-album">несколько вопросов самому себе</span>
          </div>
          <span class="favorite-duration">4:39</span>
        </div>
        <p class="favorite-note">Та самая композиция, которую хочется выделить отдельно.</p>
      </section>

      <details class="track-details surface">
        <summary>
          <span class="summary-copy">
            <span class="eyebrow">Tracklist</span>
            <strong>Посмотреть весь треклист</strong>
          </span>
          <span class="summary-meta">19 TRACKS <span class="summary-chevron">⌄</span></span>
        </summary>
        <ol class="track-list">
          {tracks.map(([name, duration], index) => (
            <li>
              <span class="track-number">{String(index + 1).padStart(2, "0")}</span>
              <span class:list={["track-name", name === "неважно" && "is-favorite"]}>{name}</span>
              <span class="track-duration">{duration}</span>
            </li>
          ))}
        </ol>
      </details>
    </section>
    <p class="library-footnote">Обложка пока временная — заменю её на оригинальную, когда добавим файл. Аудиофайлы не загружаются в репозиторий.</p>
  </section>
</BaseLayout>

<style>
  .page { min-height: 70vh; padding-block: 6rem 5rem; }
  .page-heading { margin-bottom: 3rem; }
  h1 { margin: 1rem 0 .7rem; font-size: clamp(3.2rem, 8vw, 5.8rem); letter-spacing: -.085em; line-height: .98; }
  h1 span { color: var(--accent); }
  .page-heading > p { max-width: 590px; color: var(--muted); line-height: 1.8; }
  .library { display: grid; gap: 1.25rem; }
  .album { display: grid; grid-template-columns: minmax(240px, .82fr) 1.18fr; gap: clamp(1.5rem, 4vw, 3.5rem); padding: clamp(1rem, 3vw, 2rem); overflow: hidden; }
  .album-art { position: relative; display: flex; min-height: 360px; aspect-ratio: 1 / 1; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 1.25rem; isolation: isolate; background: radial-gradient(ellipse at 72% 22%, #9d5b36 0, transparent 34%), radial-gradient(ellipse at 18% 82%, #5b2c20 0, transparent 42%), linear-gradient(145deg, #31221c, #100e0d 72%); color: #f5e9dc; }
  .album-art::before { position: absolute; z-index: -1; inset: 9%; border: 1px solid rgb(255 226 199 / 24%); border-radius: 50%; content: ""; transform: rotate(-28deg) scaleX(.76); }
  .album-art::after { position: absolute; z-index: -1; width: 70%; aspect-ratio: 1; top: 15%; left: 15%; border: 1px solid rgb(255 138 42 / 35%); border-radius: 50%; box-shadow: 0 0 80px rgb(255 138 42 / 13%), inset 0 0 50px rgb(255 138 42 / 8%); content: ""; }
  .art-grain { position: absolute; z-index: -1; inset: 0; opacity: .2; background-image: radial-gradient(rgb(255 255 255 / 55%) .5px, transparent .7px); background-size: 5px 5px; }
  .art-index, .art-bottom { color: #d5b8a2; font: .58rem "DM Mono", monospace; letter-spacing: .16em; }
  .art-center { display: grid; gap: 1rem; margin-block: auto; padding-block: 2rem; }
  .art-small { color: #ffb77e; font: .58rem "DM Mono", monospace; letter-spacing: .18em; }
  .art-title { font-size: clamp(2rem, 4.1vw, 3.8rem); font-weight: 800; letter-spacing: -.085em; line-height: .98; }
  .art-bottom { align-self: end; }
  .album-info { display: flex; flex-direction: column; justify-content: center; padding-block: .5rem; }
  .album-kicker { display: flex; justify-content: space-between; color: var(--accent); font: .68rem "DM Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .album-kicker span { color: var(--muted); }
  h2 { margin: 1.2rem 0 .45rem; font-size: clamp(2rem, 4.4vw, 3.5rem); letter-spacing: -.075em; line-height: 1.02; }
  .artist { margin: 0; color: var(--accent-strong); font-size: 1.05rem; font-weight: 700; }
  .album-description { max-width: 490px; margin-top: 1.4rem; color: var(--muted); line-height: 1.8; }
  .album-meta { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; margin-top: .9rem; color: #d6c5b8; font: .7rem "DM Mono", monospace; }
  .album-meta i { width: 3px; height: 3px; border-radius: 50%; background: var(--accent); }
  .album-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; }
  .listen-button { display: inline-flex; align-items: center; gap: .65rem; padding: .9rem 1.15rem; border: 1px solid rgb(255 138 42 / 45%); border-radius: 999px; background: linear-gradient(135deg, #ff9a45, #e86a20); color: #211209; font-weight: 800; transition: transform 180ms ease, box-shadow 180ms ease; }
  .listen-button:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgb(255 138 42 / 20%); }
  .listen-button svg { width: 1.2rem; height: 1.2rem; fill: currentColor; }
  .text-link { color: var(--muted); font-weight: 700; }
  .track-section { padding: clamp(1.2rem, 3vw, 2rem); }
  .track-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding-bottom: 1.2rem; border-bottom: 1px solid rgb(255 255 255 / 8%); }
  .track-heading h3 { margin: .55rem 0 0; font-size: 1.65rem; letter-spacing: -.055em; }
  .track-count { color: var(--muted); font: .62rem "DM Mono", monospace; letter-spacing: .12em; }
  .track-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; margin: .4rem 0 0; padding: 0; list-style: none; }
  .track-list li { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; align-items: center; gap: .7rem; min-height: 3.15rem; border-bottom: 1px solid rgb(255 255 255 / 6%); }
  .track-number, .track-duration { color: #827267; font: .68rem "DM Mono", monospace; }
  .track-name { overflow: hidden; color: #e9ddd3; font-size: .88rem; text-overflow: ellipsis; white-space: nowrap; }\n  .track-name.is-favorite { color: var(--accent-strong); font-weight: 800; }
  .track-list li:hover .track-name { color: var(--accent-strong); }
  .player-note { display: flex; align-items: center; gap: .65rem; margin: 1.5rem 0 0; color: var(--muted); font-size: .78rem; line-height: 1.6; }
  .player-note span { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .library-footnote { margin-top: 1.2rem; color: #897a70; font-size: .75rem; line-height: 1.7; }
  @media (max-width: 760px) { .page { padding-block: 4rem; } .album { grid-template-columns: 1fr; } .album-art { width: min(100%, 430px); min-height: 0; justify-self: center; } .album-info { padding: .5rem .2rem 1rem; } .track-list { grid-template-columns: 1fr; } .favorite-note { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .listen-button { transition: none; } }
</style>
