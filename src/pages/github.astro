---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="GitHub — Switty">
  <section class="page container">
    <span class="eyebrow">Open source</span>
    <h1>GitHub<span>.</span></h1>
    <p>Мои репозитории, эксперименты и открытая разработка.</p>
    <a class="profile surface" href="https://github.com/swittyy" target="_blank" rel="noreferrer">
      <span class="avatar">s.</span>
      <span class="profile-copy"><strong>@swittyy</strong><small>Открыть профиль на GitHub</small></span>
      <span class="arrow"><svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.05c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.2 3.29 1.56.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.61 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.25-5.1 5.53.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.52A11.1 11.1 0 0 0 12 .9Z"/></svg></span>
    </a>
  </section>
</BaseLayout>
<style>
  .page { min-height: 70vh; padding-block: 6rem; }
  h1 { margin: 1rem 0; font-size: clamp(3rem, 8vw, 5.5rem); letter-spacing: -.08em; }
  h1 span { color: var(--accent); }
  .page > p { max-width: 560px; color: var(--muted); line-height: 1.8; }
  .profile { display: flex; align-items: center; gap: 1rem; max-width: 500px; margin-top: 3rem; padding: 1.3rem; transition: border-color 180ms ease, transform 180ms ease; }
  .profile:hover { transform: translateY(-3px); border-color: var(--accent); }
  .avatar { display: grid; width: 54px; height: 54px; place-items: center; border-radius: 18px; background: var(--accent); color: #241b35; font: 800 1.3rem "DM Mono", monospace; }
  .profile-copy { display: grid; gap: .3rem; }
  .profile-copy small { color: var(--muted); }
  .arrow { display: inline-flex; margin-left: auto; color: var(--accent); }
  .github-icon { width: 1.35rem; height: 1.35rem; }
</style>
