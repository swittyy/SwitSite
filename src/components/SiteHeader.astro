---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(base, "/");
const links = [
  { label: "Главная", href: `${base}/`, path: "/" },
  { label: "Проекты", href: `${base}/projects/`, path: "/projects/" },
  { label: "Музыка", href: `${base}/music/`, path: "/music/" },
  { label: "GitHub", href: `${base}/github/`, path: "/github/" },
  { label: "Контакты", href: `${base}/contacts/`, path: "/contacts/" },
];
---
<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href={`${base}/`} aria-label="Switty — на главную">
      <span class="brand-mark">s.</span>
      <span>switty<span class="brand-dot">.</span></span>
    </a>

    <nav aria-label="Основная навигация">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav-link", { active: currentPath === link.path || (link.path !== "/" && currentPath.startsWith(link.path)) }]}
          aria-current={currentPath === link.path ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a class="header-github" href="https://github.com/swittyy" target="_blank" rel="noreferrer">
      <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.05c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.2 3.29 1.56.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.61 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.25-5.1 5.53.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.52A11.1 11.1 0 0 0 12 .9Z"/></svg>
      <span>GitHub</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    background: rgb(17 16 20 / 82%);
    backdrop-filter: blur(20px);
  }

  .header-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 12px;
    background: var(--accent);
    color: #241b35;
    font: 800 1rem "DM Mono", monospace;
  }

  .brand-dot {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-link {
    padding: 0.65rem 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.86rem;
    transition: color 180ms ease, background 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    background: rgb(208 188 255 / 10%);
    color: var(--accent);
  }

  .header-github {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--outline);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    transition: border-color 180ms ease, background 180ms ease;
  }

  .github-icon { width: 1.15rem; height: 1.15rem; flex: 0 0 auto; }

  .header-github:hover {
    border-color: var(--accent);
    background: rgb(208 188 255 / 8%);
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 68px;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      padding-block: 0.7rem;
    }

    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      overflow-x: auto;
    }

    .nav-link {
      padding: 0.55rem 0.65rem;
      white-space: nowrap;
      font-size: 0.78rem;
    }

    .header-github {
      margin-left: auto;
    }
  }
</style>
