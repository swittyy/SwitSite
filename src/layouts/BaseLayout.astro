---
import SiteHeader from "@components/SiteHeader.astro";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Switty — personal space",
  description = "Личное цифровое пространство Switty: проекты, музыка и мысли.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111014" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("is-loading");
    </script>
  </head>
  <body>
    <div class="site-loader" id="site-loader" role="status" aria-label="Загрузка сайта">
      <div class="loader-atmosphere" aria-hidden="true"></div>
      <div class="loader-content">
        <div class="loader-identity">
          <div class="loader-mark-wrap">
            <div class="loader-mark-orbit orbit-a"></div>
            <div class="loader-mark-orbit orbit-b"></div>
            <div class="loader-mark"><span>S</span></div>
            <span class="loader-spark spark-a"></span>
            <span class="loader-spark spark-b"></span>
          </div>
          <div class="loader-wordmark">SWITTY<span>.</span></div>
          <div class="rust-tagline rust-tagline-loader" id="loader-rust-tagline">
            <svg class="rust-symbol" viewBox="0 0 64 64" aria-hidden="true"><path d="M18 7h28l4 8 8 4v26l-8 4-4 8H18l-4-8-8-4V19l8-4z" fill="currentColor"/><circle cx="32" cy="32" r="13" fill="#0d0c0b"/><circle cx="32" cy="32" r="5" fill="currentColor"/></svg>
            <span>Rust. Learn. Evolve.</span>
          </div>
          <div class="loader-caption">A LITTLE SPACE ON THE INTERNET</div>
        </div>
        <div class="loader-bottom">
          <div class="loader-status"><span>CRAFTING YOUR EXPERIENCE</span><span>PLEASE WAIT</span></div>
          <div class="loader-progress"><span></span></div>
          <div class="loader-coordinates"><span>PERSONAL DIGITAL SPACE</span><span>EST. 2026</span></div>
        </div>
      </div>
    </div>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} Switty</span>
        <span>Made with curiosity.</span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const loader = document.getElementById("site-loader");
        const revealTargets = document.querySelectorAll(
          ".site-header, main .eyebrow, main h1, main h2, main h3, main p, main .hero-actions, main .hero-meta, main .project-card, main .explore-card, .site-footer"
        );
        const loaderTagline = document.getElementById("loader-rust-tagline");
        const heroTagline = document.getElementById("hero-rust-tagline");

        revealTargets.forEach((element, index) => {
          element.style.setProperty("--reveal-delay", `${Math.min(index * 55, 900)}ms`);
        });

        window.setTimeout(() => {
          document.documentElement.classList.remove("is-loading");
          document.documentElement.classList.add("is-loaded");
          if (loaderTagline && heroTagline && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const from = loaderTagline.getBoundingClientRect();
            const to = heroTagline.getBoundingClientRect();
            const dx = to.left + to.width / 2 - (from.left + from.width / 2);
            const dy = to.top + to.height / 2 - (from.top + from.height / 2);
            const sx = to.width / from.width;
            const sy = to.height / from.height;
            heroTagline.classList.add("is-transfer-hidden");
            loaderTagline.animate(
              [{ transform: "translate(0, 0) scale(1)", opacity: 1 },
               { transform: "translate(" + dx + "px, " + dy + "px) scale(" + sx + ", " + sy + ")", opacity: 1 }],
              { duration: 760, easing: "cubic-bezier(.22, 1, .36, 1)", fill: "forwards" }
            ).onfinish = () => {
              heroTagline.classList.remove("is-transfer-hidden");
              loaderTagline.style.visibility = "hidden";
            };
          }
          loader?.classList.add("is-leaving");
          window.setTimeout(() => loader?.remove(), 800);
        }, 2000);
      })();
    </script>
  </body>
</html>

<style>
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
